{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ip-lookup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker owns routing so it can serve /api/* and fall through to assets.
    "run_worker_first": true
  },
  "secrets": {
    "required": ["IPINFO_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
