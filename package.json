{
  "name": "ip-lookup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight IP address lookup built on Cloudflare Workers and the IPinfo Lite API.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
